{% extends 'base.html.twig' %}

{% block title %}Inscription | OwoFofo{% endblock %}

{% block body %}
{# Écran de création de compte utilisateur. #}
<section class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <article class="card bg-body-tertiary border-secondary-subtle shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Création de compte</h1>

                {# Formulaire Symfony d'inscription. #}
                {{ form_start(formulaireInscription) }}
                    {{ form_row(formulaireInscription.nom) }}
                    {{ form_row(formulaireInscription.motDePasseEnClair.first) }}
                    {{ form_row(formulaireInscription.motDePasseEnClair.second) }}
                    <button type="submit" class="btn btn-primary w-100">Créer mon compte</button>
                {{ form_end(formulaireInscription) }}
            </div>
        </article>
    </div>
</section>
{% endblock %}